# AutoTriage-ITSM — example environment (copy to backend/.env and root .env)
APP_NAME=AutoTriage-ITSM
ENVIRONMENT=development
DEBUG=true

# Database (async DSN; database.py coerces postgresql:// -> postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://autouser:autopass@localhost:5432/autotriage

# Redis / Celery (docker-compose sets REDIS_URL for the container network)
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://:redispass@redis:6379/0
# CELERY_RESULT_BACKEND=redis://:redispass@redis:6379/0

# LLM keys are OPTIONAL — the prototype falls back to deterministic
# Tier-1 / rule classification and extractive RAG steps without them.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-1.5-flash

VECTOR_DIMENSION=1536
KB_SEARCH_K=5
CONFIDENCE_THRESHOLD=0.85
LOG_LEVEL=INFO
